{
  "version": "1.0-pass49",
  "stage": "limited_real_matter_pilot",
  "allowed_users": "limited_named_attorney_tenant_group_only",
  "required_controls": [
    "explicit_privacy_consent",
    "limited_tenant_allowlist",
    "matter_level_isolation",
    "local_encryption",
    "human_review_required",
    "export_restrictions",
    "incident_process",
    "daily_pilot_review"
  ],
  "required_work_product_artifacts": [
    "issue_tree",
    "posture_summary",
    "timeline",
    "evidence_map",
    "authority_matrix",
    "red_flag_report"
  ],
  "forbidden_conditions": [
    "private_data_training_enabled",
    "data_leakage_detected",
    "unsupported_filing_ready_export",
    "open_incident_without_blocker",
    "missing_attorney_signoff"
  ],
  "exit_criteria": [
    "no_data_leakage",
    "no_unsupported_filing_ready_exports",
    "matter_workflows_produce_useful_artifacts",
    "pilot_attorneys_sign_off_or_list_blockers"
  ],
  "launch_rule": "Real-matter pilot stays limited, consented, encrypted, isolated, and human-reviewed; it cannot graduate to GA without release-candidate signoffs."
}
