{
  "schema_version": "1.0",
  "workflows": {
    "divorce": {
      "required_fields": ["county", "children_involved", "service_status", "requested_relief"],
      "recommended_fields": ["existing_orders", "income_summary", "property_and_debt_summary", "safety_concerns"],
      "sensitive_fields": ["address", "dob", "ssn", "minor_identifiers", "medical_details", "financial_account_numbers"],
      "questions": {
        "county": {
          "attorney": "Which Maine county and court division are involved?",
          "self_represented": "Which Maine court or county is this case in, if you know?"
        },
        "children_involved": {
          "attorney": "Are minor children involved and are there any existing child-related orders?",
          "self_represented": "Are there children involved, and is there already a court order about them?"
        },
        "service_status": {
          "attorney": "What is the service posture and are any response dates already running?",
          "self_represented": "Have papers already been served, and do you see any deadlines on them?"
        },
        "requested_relief": {
          "attorney": "What exact relief is being requested?",
          "self_represented": "What are you asking the court to do?"
        }
      }
    },
    "parental_rights_and_responsibilities": {
      "required_fields": ["children_involved", "existing_orders", "requested_relief", "safety_concerns"],
      "recommended_fields": ["primary_residence_status", "contact_schedule_status", "best_interest_facts", "jurisdiction_facts"],
      "sensitive_fields": ["address", "minor_identifiers", "juvenile_details", "medical_details"],
      "questions": {
        "existing_orders": {
          "attorney": "Is there a temporary or final parenting order already in place?",
          "self_represented": "Is there already a court order about where the child lives or contact with the child?"
        }
      }
    },
    "child_support": {
      "required_fields": ["children_involved", "income_summary", "existing_orders", "requested_relief"],
      "recommended_fields": ["childcare_costs", "health_insurance", "support_worksheet_status", "deviation_facts"],
      "sensitive_fields": ["ssn", "financial_account_numbers", "employer_account_numbers", "dob"],
      "questions": {
        "income_summary": {
          "attorney": "What current income information is available for each parent?",
          "self_represented": "Do you have current income information for each parent?"
        }
      }
    },
    "parentage": {
      "required_fields": ["children_involved", "existing_orders", "requested_relief"],
      "recommended_fields": ["acknowledgment_status", "testing_status", "jurisdiction_facts"],
      "sensitive_fields": ["minor_identifiers", "dob", "medical_details"],
      "questions": {}
    },
    "motion_to_modify": {
