      "recommended_fields": ["children_involved", "service_status", "best_interest_facts", "supporting_documents"],
      "sensitive_fields": ["minor_identifiers", "medical_details", "financial_account_numbers"],
      "questions": {}
    },
    "motion_to_enforce": {
