  "default_windows_data_root": "C:\\dev\\ME_FM_LLM_data",
  "default_posix_data_root_suffix": "../ME_FM_LLM_data",
  "network_policy": {
    "respect_robots_txt": true,
    "default_delay_seconds": 1.0,
    "default_timeout_seconds": 45,
    "default_max_retries": 3,
    "user_agent": "MaineFamilyLawLLM-EnterpriseResourceCollector/1.0 (+official legal data verification)",
