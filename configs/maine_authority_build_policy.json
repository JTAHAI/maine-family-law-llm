{
  "version": "1.0-pass17-external-authority-build",
  "purpose": "Production authority corpus build policy for official Maine legal data snapshots stored outside the source repository.",
  "external_data_root_required": true,
  "official_store_name": "official_authority_store",
  "manifest_filename": "source_manifest.json",
  "minimum_ingested_targets": 31,
  "required_source_class_minimums": {
    "statute_title_index": 9,
    "statute_title_pdf": 9,
    "court_rules_index": 4,
    "court_forms_index": 1,
    "court_policy_index": 1,
    "law_court_opinion_index": 7
  },
  "acceptable_parser_statuses": [
    "parsed",
    "snapshot_only"
  ],
  "parsed_status_required_for_classes": [
    "statute_title_index",
    "court_rules_index",
    "court_forms_index",
    "court_policy_index",
    "law_court_opinion_index"
  ],
  "snapshot_only_allowed_for_classes": [
    "statute_title_pdf"
  ],
  "required_manifest_fields": [
    "source_id",
    "source_class",
    "jurisdiction",
    "retrieved_at",
    "hash",
    "parser_status",
    "freshness_status",
    "data_class",
    "source_url_or_path",
    "snapshot_path",
    "parser_audit"
  ],
  "minimum_snapshot_bytes": 1,
  "require_snapshot_files_exist": true,
  "require_manifest_hash_matches_snapshot": true,
  "production_blockers": [
    "manifest_missing",
    "manifest_parse_error",
    "external_data_root_inside_repo",
    "minimum_ingested_targets_not_met",
    "source_class_minimum_not_met",
    "missing_required_manifest_field",
    "snapshot_missing",
    "snapshot_hash_mismatch",
    "parser_status_not_acceptable",
    "parsed_status_required",
    "freshness_unknown"
  ]
}
