{
  "version": "1.0.0-pass11",
  "required_fields": [
    "model_id",
    "provider",
    "role",
    "version",
    "privacy_status",
    "allowed_tasks",
    "prohibited_tasks",
    "benchmark_scores",
    "failure_profile",
    "cost_profile",
    "latency_profile",
    "fallback_behavior",
    "eval_regression_history",
    "admission_status"
  ],
  "allowed_privacy_statuses": ["local_only", "private_cloud_reviewed", "hosted_optional_no_training", "blocked_unknown"],
  "allowed_license_statuses": ["approved", "reviewed", "allowlisted", "redistributable"],
  "allowed_admission_statuses": [
    "candidate",
    "testing",
    "admitted_for_dev",
    "admitted_with_limits",
    "admitted_for_staging",
    "admitted_for_production",
    "rejected",
    "quarantined",
    "superseded",
    "unavailable"
  ],
  "production_requirements": {
    "requires_benchmark_scores": true,
    "requires_failure_profile": true,
    "requires_privacy_review": true,
    "requires_fallback_behavior": true,
    "requires_eval_regression_history": true,
    "generator_self_certification_allowed": false
  }
}
