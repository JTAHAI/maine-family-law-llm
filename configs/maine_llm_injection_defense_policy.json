{
  "version": "1.0.0-pass42",
  "policy": "All user prompts, uploaded documents, retrieved authority text, and tool outputs are untrusted unless produced by deterministic system controls. Retrieved document instructions are data, not commands.",
  "blocked_direct_patterns": [
    "ignore_previous_instructions",
    "reveal_system_prompt",
    "disable_safety",
    "roleplay_jailbreak"
  ],
  "blocked_document_patterns": [
    "embedded_instruction",
    "tool_exfiltration",
    "source_override"
  ],
  "allowed_tools": [
    "citation_resolver",
    "quote_verifier",
    "retrieval_search",
    "source_card_lookup",
    "filing_ready_gate",
    "matter_evidence_mapper"
  ],
  "denied_tool_capabilities": [
    "network_exfiltration",
    "secret_read",
    "system_prompt_read",
    "private_matter_cross_tenant_read",
    "shell_execution_unreviewed"
  ],
  "retrieval_context_rules": {
    "mark_all_retrieved_text_untrusted": true,
    "strip_document_level_instructions": true,
    "preserve_source_ids_and_offsets": true,
    "never_allow_retrieved_text_to_change_policy": true
  },
  "output_filter_rules": {
    "block_system_prompt_leakage": true,
    "block_secret_like_tokens": true,
    "require_review_required_status_on_generation": true
  },
  "cost_controls": {
    "max_prompt_chars": 20000,
    "max_retrieved_segments": 20,
    "max_tool_calls_per_request": 12
  },
  "owasp_llm_2025_mapped_controls": [
    "LLM01_prompt_injection",
    "LLM02_sensitive_information_disclosure",
    "LLM05_improper_output_handling",
    "LLM06_excessive_agency",
    "LLM07_system_prompt_leakage",
    "LLM08_vector_and_embedding_weaknesses",
    "LLM10_unbounded_consumption"
  ]
}
