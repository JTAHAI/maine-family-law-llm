{
  "version": "1.0-pass48",
  "stage": "attorney_only_sandbox_pilot",
  "allowed_users": "licensed_or_supervised_attorney_reviewers_only",
  "allowed_data": [
    "official_public_authority",
    "synthetic_matter_fixtures",
    "deidentified_training_examples_approved_for_eval_candidate_review"
  ],
  "disallowed_data": [
    "real_private_matter_files",
    "sealed_or_juvenile_records",
    "unapproved_client_confidential_material"
  ],
  "required_onboarding": [
    "bar_status_or_supervising_attorney_verification",
    "terms_or_nda_acceptance",
    "data_boundaries_training",
    "source_grounding_training",
    "citation_quote_verification_training",
    "review_required_export_training",
    "feedback_and_error_reporting_training"
  ],
  "required_operations": [
    "attorney_onboarding_packet",
    "training_materials",
    "feedback_workflow",
    "error_triage",
    "human_review_queue",
    "pilot_dashboard",
    "eval_candidate_creation_from_feedback"
  ],
  "exit_criteria": [
    "attorneys_can_use_research_and_review_without_unsupported_claim_reliance",
    "feedback_generates_fix_tickets_or_eval_candidates",
    "no_open_critical_safety_or_security_issues",
    "all_outputs_remain_review_required"
  ],
  "launch_rule": "The attorney-only sandbox may not accept real private matter files and may not mark any draft filing-ready."
}
