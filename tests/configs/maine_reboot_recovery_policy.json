{
  "policy_id": "maine_reboot_recovery_policy_v1",
  "purpose": "Make the enterprise test tree safe to resume after a workstation reboot without confusing source readiness with production legal readiness.",
  "default_windows_repo_root": "C:\\dev\\ME_FM_LLM",
  "default_windows_data_root": "C:\\dev\\ME_FM_LLM_data",
  "required_repo_files": [
    "README.md",
    "PASS_CHANGES.txt",
    "pyproject.toml",
    "scripts/run-test-readiness.py",
    "scripts/run-reboot-safe-healthcheck.py",
    "scripts/run-enterprise-preflight.py",
    "scripts/collect-enterprise-resources.py",
    "configs/maine_local_test_readiness_policy.json",
    "configs/maine_reboot_recovery_policy.json"
  ],
  "source_repo_must_not_contain": [
    "official_authority_store",
    "parsed_authority_store",
    "embedding_store",
    "eval_store",
    "matter_store",
    "runtime",
    "uploads",
    "vectorstores",
    "corpora",
    ".env"
  ],
  "required_external_data_dirs": [
    "official_authority_store",
    "parsed_authority_store",
    "embedding_store",
    "eval_store",
    "matter_store",
    "runtime",
    "logs",
    "reports",
    "release_evidence"
  ],
  "after_reboot_windows_commands": [
    "cd C:\\dev\\ME_FM_LLM",
    "py -3.11 scripts\\run-reboot-safe-healthcheck.py --data-root C:\\dev\\ME_FM_LLM_data",
    "py -3.11 scripts\\run-test-readiness.py --data-root C:\\dev\\ME_FM_LLM_data --skip-pytest",
    "py -3.11 scripts\\run-enterprise-preflight.py --data-root C:\\dev\\ME_FM_LLM_data"
  ],
  "networked_collection_commands": [
    "py -3.11 scripts\\collect-enterprise-resources.py --data-root C:\\dev\\ME_FM_LLM_data",
    "py -3.11 scripts\\ingest-maine-authority.py --data-root C:\\dev\\ME_FM_LLM_data",
    "py -3.11 scripts\\build-parsed-authority-store.py --data-root C:\\dev\\ME_FM_LLM_data",
    "py -3.11 scripts\\build-retrieval-indexes.py --data-root C:\\dev\\ME_FM_LLM_data",
    "py -3.11 scripts\\audit-enterprise-readiness.py --data-root C:\\dev\\ME_FM_LLM_data --eval-root C:\\dev\\ME_FM_LLM_data\\eval_store"
  ],
  "production_legal_readiness_remains_blocked_until": [
    "live official Maine authority snapshots are collected into the external data root",
    "parsed authority stores and retrieval indexes are generated from those snapshots",
    "attorney-reviewed gold eval packs replace seed/fixture rows",
    "real release metrics meet GA thresholds",
    "pilot/security evidence and owner signoffs are attached"
  ]
}
